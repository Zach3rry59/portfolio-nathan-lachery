# Copier ce fichier en .env à la racine. Ne jamais versionner .env.
PORT=3001
HOST=127.0.0.1
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# URI de votre base MongoDB locale ou Atlas. Vide = lecture du projet de référence,
# contacts indisponibles. Aucun enregistrement n'est simulé en production.
MONGODB_URI=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# 1 uniquement derrière le proxy de l’hébergeur ; 0 en accès direct.
TRUST_PROXY=0
NODE_ENV=development
# En déploiement, configurer l'origine HTTPS exacte du frontend et HOST=0.0.0.0.
